{
  "name": "project-knowledge-maintainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "schema:write": "npm run build && node .build/tools/generate-schema.mjs --write",
    "schema:check": "npm run build && node .build/tools/generate-schema.mjs --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test .build/tests/*.test.mjs",
    "check:public": "npm run build && node .build/tools/check-public.mjs",
    "package": "npm run build && python3 tools/package-release.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "6.0.3"
  }
}
