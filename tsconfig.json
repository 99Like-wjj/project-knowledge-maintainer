{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noEmitOnError": true, "verbatimModuleSyntax": true, "skipLibCheck": true,
    "rootDir": ".", "outDir": ".build", "types": ["node"]
  },
  "include": ["src/**/*.mts", "tests/**/*.mts", "tools/**/*.mts"]
}
