/** Current-source heuristic check. No upload, deletion, or claim of complete privacy detection. */
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {fileURLToPath} from 'node:url';
import {checkSecrets} from '../src/contract.mjs';
const root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'../..'),errors:string[]=[],files:string[]=[];
const roots=new Set(['LICENSE','README.md','README.en.md','CHANGELOG.md','AGENTS.md','.gitignore','.gitattributes','package.json','package-lock.json','tsconfig.json','docs','src','skills','schemas','examples','tests','tools']);
// User-approved public contact image, copied byte-for-byte from the Ego Skill repository.
// Any replacement requires a fresh review; other binary files remain disallowed.
const approvedContactImage={path:'docs/images/wechat-contact-qr.png',sha256:'2031e10caed00aeb08939aa2ec6586a357e963621d284f4de252889a8ee7e5e4'};
async function walk(directory:string,relative=''):Promise<void>{for(const entry of await fs.readdir(directory,{withFileTypes:true})){if(!relative&&['.git','.build','node_modules'].includes(entry.name))continue;const name=relative?relative+'/'+entry.name:entry.name;if(!relative&&!roots.has(entry.name)){errors.push(name+': outside source allowlist');continue;}if(entry.isSymbolicLink()){errors.push(name+': symlink');continue;}if(entry.isDirectory()){if(/^(?:private|outputs|reports|logs|screenshots|credentials|raw-inputs)$/.test(entry.name)){errors.push(name+': private/output directory');continue;}await walk(path.join(directory,entry.name),name);continue;}if(!entry.isFile()){errors.push(name+': irregular file');continue;}const data=await fs.readFile(path.join(directory,entry.name));if(name===approvedContactImage.path){if(data.length>1024*1024||createHash('sha256').update(data).digest('hex')!==approvedContactImage.sha256){errors.push(name+': contact image differs from reviewed bytes');continue;}files.push(name);continue;}if(data.length>1024*1024||!Buffer.from(data.toString('utf8'),'utf8').equals(data)||data.includes(0)){errors.push(name+': invalid text/size');continue;}try{checkSecrets(data.toString('utf8'));}catch{errors.push(name+': possible credential; value suppressed');}files.push(name);}}
await walk(root);process.stdout.write(JSON.stringify({ok:!errors.length,scannedFiles:files.length,errors,limitations:['Current source only; no Git history or remote artifacts.','Heuristics do not prove absence of business/private data; per-file human/AI review remains required.']},null,2)+'\n');if(errors.length)process.exitCode=1;
