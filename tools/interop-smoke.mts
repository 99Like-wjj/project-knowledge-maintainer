/** Real producer→Ego CLI interop using only entirely synthetic data and an explicit external output. */
import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {execFile} from 'node:child_process';import {promisify} from 'node:util';import assert from 'node:assert/strict';
import {bytes,digest} from '../src/contract.mjs';import {seedFiles} from '../tests/fixture.mjs';
const exec=promisify(execFile),sourceRoot=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'../..'),cli=path.join(sourceRoot,'.build/src/cli.mjs');
const [egoCli,outputRoot]=process.argv.slice(2);if(!egoCli||!outputRoot||!path.isAbsolute(egoCli)||!path.isAbsolute(outputRoot))throw new Error('Provide explicit Ego CLI and new external output root.');
const relative=path.relative(sourceRoot,outputRoot);if(!relative||relative!=='..'&&!relative.startsWith('..'+path.sep)&&!path.isAbsolute(relative))throw new Error('Use an external synthetic output root.');await fs.mkdir(outputRoot);
const call=async(entry:string,args:string[])=>JSON.parse((await exec(process.execPath,[entry,...args],{encoding:'utf8',windowsHide:true,maxBuffer:4*1024*1024})).stdout);
let sequence=0;const input=async(v:unknown)=>{const file=path.join(outputRoot!,++sequence+'-synthetic-request.json');await fs.writeFile(file,bytes(v),{flag:'wx'});return file;};
const root=path.join(outputRoot,'synthetic-library'),init=await call(cli,['init','--knowledge-root',root,'--request',await input({projectName:'完全合成项目A',projectId:'synthetic-project-a'})]);
const saved=await call(cli,['save','--knowledge-root',root,'--request',await input({projectId:init.header.projectId,knowledgeId:init.header.knowledgeId,expectedSnapshotSha256:init.snapshotSha256,files:seedFiles(),reason:'完全合成四类资料联通。',backupDir:path.join(outputRoot,'retained')})]);
const query={expectedProject:{id:'synthetic-project-a'},category:'modules',recordIds:['catalogue'],includeRelated:true,maxDepth:1,limit:50,maxBytes:100000};
const out=path.join(outputRoot,'knowledge-context.json'),receipt=await call(egoCli,['knowledge','read','--knowledge-root',root,'--request',await input(query),'--output-file',out]),value=JSON.parse(await fs.readFile(out,'utf8'));
assert.equal(value.knowledgeReadVersion,3);assert.equal(value.availability,'available');for(const id of ['catalogue','owned-data','catalogue-maintainer'])assert.ok(value.items.some((v:{id:string})=>v.id===id));assert.equal(receipt.sourceRef.sha256,digest(await fs.readFile(out)));
const declared=await call(egoCli,['knowledge','read','--knowledge-root',root,'--request',await input({expectedProject:{id:'synthetic-project-a'},category:'accounts',recordIds:['test-account-a']})]);assert.deepEqual(declared.items[0].content,seedFiles()['accounts.json'].items[0]);assert.ok(!('states'in declared.items[0]));
const minimalRoot=path.join(outputRoot,'minimal-user-configuration'),minimal=await call(cli,['init','--knowledge-root',minimalRoot,'--request',await input({projectName:'完全合成配置项目B',projectId:'synthetic-config-b'})]);
const minimalFiles={'project.json':{items:[{id:'one-homepage',title:'完全合成站点',properties:{入口:'https://example.invalid/',登录说明:'人工登录',自定义属性:{free:true,values:[1,null]}}}]},'accounts.json':{items:[{id:'minimal-account',title:'完全合成账号'}]}};
await call(cli,['save','--knowledge-root',minimalRoot,'--request',await input({projectId:minimal.header.projectId,knowledgeId:minimal.header.knowledgeId,expectedSnapshotSha256:minimal.snapshotSha256,files:minimalFiles,reason:'完全合成用户输入，无角色或环境档案。',backupDir:path.join(outputRoot,'minimal-history')})]);
for(const [category,name]of [['project','project.json'],['accounts','accounts.json']] as const){const read=await call(egoCli,['knowledge','read','--knowledge-root',minimalRoot,'--request',await input({expectedProject:{id:'synthetic-config-b'},category})]);assert.equal(read.availability,'available');assert.deepEqual(read.items[0].content,minimalFiles[name].items[0]);assert.deepEqual(read.sources,[]);}
const wrong=await call(egoCli,['knowledge','read','--knowledge-root',root,'--request',await input({...query,expectedProject:{id:'another-project'}})]);assert.equal(wrong.availability,'unavailable');assert.equal(wrong.items.length,0);
const skipped=await call(egoCli,['knowledge','inspect']);assert.equal(skipped.availability,'not_configured');
await fs.writeFile(path.join(outputRoot,'interop-report.json'),bytes({synthetic:true,formatVersion:3,producerToEgo:true,independentNavigationAndRulesRead:true,lightweightUserConfigurationRead:true,customPropertiesPreserved:true,minimalAccountNeedsNoRegistries:true,sourceRefHashVerified:true,wrongProjectRefused:true,noKnowledgeIsOptional:true,snapshotSha256:saved.snapshotSha256,realBusinessTested:false}),{flag:'wx'});
console.log(bytes({ok:true,report:path.join(outputRoot,'interop-report.json')}));
